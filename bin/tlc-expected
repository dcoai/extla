#!/usr/bin/env bash
# Regenerate (or verify) the TLC side of the differential corpus.
#
#   bin/tlc-expected                 regenerate expected.json for every entry
#   bin/tlc-expected die_hard        regenerate one entry
#   bin/tlc-expected --check         re-run TLC and fail on any drift (CI)
#
# It records the safety verdicts (state counts, deadlock, invariants) and, from
# a run of its own per property, TLC's verdict on each temporal property.
#
# expected.json is what TLC reported, never hand-edited: it is the oracle ExTLA
# is measured against (spec/08-decisions.md D-9), so a human editing it to make a
# test pass would be editing the definition of "correct".
set -euo pipefail

readonly ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly CORPUS="$ROOT/test/differential"

# Pinned rather than "latest": TLC's state counts are the fixture, so the tool
# that produces them is part of the fixture. Bumping this is a reviewable commit
# in which every expected.json is expected to change.
readonly TLA_TOOLS_VERSION="v1.7.4"
readonly TLA_TOOLS_SHA256="936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88"
readonly TLA_TOOLS_URL="https://github.com/tlaplus/tlaplus/releases/download/${TLA_TOOLS_VERSION}/tla2tools.jar"
readonly JAR="$ROOT/.tla/tla2tools.jar"

die() { echo "tlc-expected: $*" >&2; exit 1; }

# The derived .cfgs below live here rather than beside the module: a stray
# .cfg in a corpus directory is one a later run could pick up.
readonly WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

ensure_jar() {
  if [[ -f "$JAR" ]] && echo "$TLA_TOOLS_SHA256  $JAR" | sha256sum --check --status; then
    return
  fi
  echo "==> fetching tla2tools.jar $TLA_TOOLS_VERSION"
  mkdir -p "$(dirname "$JAR")"
  curl --fail --silent --show-error --location --output "$JAR" "$TLA_TOOLS_URL"
  echo "$TLA_TOOLS_SHA256  $JAR" | sha256sum --check --status \
    || die "checksum mismatch on $TLA_TOOLS_URL -- refusing to trust the oracle"
}

# TLC's stdout, for one entry. `-continue` is what keeps an invariant violation
# from ending the search: without it TLC halts at the first one and never reports
# the state count, so the two things the corpus compares could not come from the
# same search. `-workers 1` keeps the run deterministic.
#
# `-continue` does NOT cover deadlock: a reached deadlock ends the search whatever
# else is set, leaving states on the queue. Passing `-deadlock` turns that check
# off, which is the second pass below.
#
# Nor does it cover a temporal violation. TLC checks temporal properties DURING
# the search and stops at the first one it refutes, wherever the search happens
# to have got to -- two runs of `raft_election` stopped at 20,253 and 20,291
# distinct states. So the pass that produces the counts runs from a .cfg with
# the PROPERTIES section removed, and every property gets a run of its own.
run_tlc() {
  local dir="$1" module="$2" extra="${3:-}"
  ( cd "$dir" && java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC \
      -continue $extra -workers 1 -cleanup "$module" 2>&1 ) || true
  # `-cleanup` removes TLC's scratch directory when the run ends normally, and a
  # refuted temporal property is not that: it leaves `states/<timestamp>/` behind
  # in the corpus. Nothing here ever reads it, so remove it either way.
  rm -rf "$dir/states"
}

# TLC reports a violation as
#
#   Error: Invariant NotSolved is violated.
#   Error: The behavior up to this point is:
#   State 1: <Initial predicate>
#   ...
#   State 7: <BigToSmall ...>
#
# so the trace length is the highest `State N:` before the next violation
# report -- blank lines separate states inside one trace and do not end it. TLC
# searches breadth-first, so the FIRST report for an invariant is the shortest
# counterexample; later ones are other states at the same or greater depth.
parse_violations() {
  awk '
    function flush() {
      if (inv != "" && depth > 0 && !(inv in seen)) { seen[inv] = depth; order[++k] = inv }
      inv = ""; depth = 0
    }
    /^Error: Invariant .* is violated\.$/ { flush(); inv = $3; next }
    /^Error: Deadlock reached\.$/         { flush(); next }
    /^[0-9]+ states generated/            { flush(); next }
    inv != "" && /^State [0-9]+:/ {
      n = $2; sub(/:$/, "", n); if (n + 0 > depth) depth = n + 0
    }
    END { flush(); for (i = 1; i <= k; i++) print order[i], seen[order[i]] }
  '
}

# Every invariant the .cfg asked TLC to check, in declaration order, so an
# invariant that holds is recorded as holding rather than merely absent.
declared_invariants() {
  awk '
    /^[[:space:]]*INVARIANTS?[[:space:]]*$/ { mode = 1; next }
    /^[[:space:]]*INVARIANTS?[[:space:]]+/  { mode = 1; $1 = ""; print; next }
    /^[[:space:]]*(SPECIFICATION|INIT|NEXT|CONSTANTS?|PROPERTIES|PROPERTY|SYMMETRY|CONSTRAINT|VIEW)([[:space:]]|$)/ { mode = 0 }
    mode { print }
  ' "$1" | tr -s ' \t' '\n\n' | grep -v '^$' || true
}

# CONSTANT assignments, echoed into expected.json so a corpus entry records the
# model it was checked at and not just the module it came from.
declared_constants() {
  awk '
    /^[[:space:]]*CONSTANTS?[[:space:]]*$/ { mode = 1; next }
    /^[[:space:]]*CONSTANTS?[[:space:]]+/  { mode = 1; $1 = ""; print; next }
    /^[[:space:]]*(SPECIFICATION|INIT|NEXT|INVARIANTS?|PROPERTIES|PROPERTY|SYMMETRY|CONSTRAINT|VIEW)([[:space:]]|$)/ { mode = 0 }
    mode { print }
  ' "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | grep -v '^$' || true
}

# Every temporal property the .cfg asked TLC to check, in declaration order --
# the same reason `declared_invariants` exists: a property that holds is
# recorded as holding rather than merely absent.
declared_properties() {
  awk '
    /^[[:space:]]*(PROPERTIES|PROPERTY)[[:space:]]*$/ { mode = 1; next }
    /^[[:space:]]*(PROPERTIES|PROPERTY)[[:space:]]+/  { mode = 1; $1 = ""; print; next }
    /^[[:space:]]*(SPECIFICATION|INIT|NEXT|CONSTANTS?|INVARIANTS?|SYMMETRY|CONSTRAINT|VIEW)([[:space:]]|$)/ { mode = 0 }
    mode
  ' "$1" | tr -s ' \t' '\n\n' | grep -v '^$' || true
}

# The committed .cfg with its PROPERTIES section dropped: the safety pass.
cfg_without_properties() {
  awk '
    /^[[:space:]]*(PROPERTIES|PROPERTY)([[:space:]]|$)/ { mode = 1; next }
    /^[[:space:]]*(SPECIFICATION|INIT|NEXT|CONSTANTS?|INVARIANTS?|SYMMETRY|CONSTRAINT|VIEW)([[:space:]]|$)/ { mode = 0 }
    !mode
  ' "$1"
}

# The committed .cfg with exactly one property and no invariants: one temporal
# pass. TLC names no property when it reports "Temporal properties were
# violated", so a run that checks several of them cannot say which one failed --
# hence one run each. The invariants go too: TLC halts on a violated invariant
# before it ever gets to the liveness check, and `die_hard` has one on purpose.
cfg_one_property() {
  awk '
    /^[[:space:]]*(INVARIANTS?|PROPERTIES|PROPERTY)([[:space:]]|$)/ { mode = 1; next }
    /^[[:space:]]*(SPECIFICATION|INIT|NEXT|CONSTANTS?|SYMMETRY|CONSTRAINT|VIEW)([[:space:]]|$)/ { mode = 0 }
    !mode
  ' "$1"
  echo "PROPERTY $2"
}

json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

generate() {
  local name="$1" out="$2"
  local dir="$CORPUS/$name"
  [[ -d "$dir" ]] || die "no such corpus entry: $name"

  local tla cfg module
  tla="$(find "$dir" -maxdepth 1 -name '*.tla' | sort | head -1)"
  [[ -n "$tla" ]] || die "$name: no .tla module"
  module="$(basename "$tla" .tla)"
  cfg="$dir/$module.cfg"
  [[ -f "$cfg" ]] || die "$name: no $module.cfg"

  echo "==> $name"

  local safety_cfg="$WORK/$name-safety.cfg"
  cfg_without_properties "$cfg" > "$safety_cfg"

  local output; output="$(run_tlc "$dir" "$module" "-config $safety_cfg")"

  # A spec with a legitimate end state (`02-dsl-semantics.md` §5.3) deadlocks
  # under TLC by construction, and that first report stops the search with states
  # still on the queue -- so its counts describe part of the state space. Whether
  # a deadlock exists comes from this pass; the counts and the invariant verdicts
  # then come from a second one with the check turned off, which is the only pass
  # that searched everything.
  local deadlock=false
  if printf '%s\n' "$output" | grep -q '^Error: Deadlock reached\.'; then
    deadlock=true
    echo "    deadlock reached; re-running with -deadlock for the complete search"
    output="$(run_tlc "$dir" "$module" "-config $safety_cfg -deadlock")"
  fi

  # Every pass from here on searches the same state space, so a spec that ends
  # somewhere needs the deadlock check off in all of them.
  local deadlock_flag=""
  if [[ $deadlock == true ]]; then deadlock_flag=" -deadlock"; fi

  # TLC prints "Model checking completed. No error has been found." even under
  # -continue with violations reported above it, so completion is read from the
  # state-count line instead -- its absence means the search did not finish.
  local distinct
  distinct="$(printf '%s\n' "$output" | sed -n 's/.*, \([0-9]*\) distinct states found.*/\1/p' | tail -1)"
  if [[ -z "$distinct" ]]; then
    printf '%s\n' "$output" >&2
    die "$name: TLC did not complete a search (no distinct-state count above)"
  fi

  local diameter
  diameter="$(printf '%s\n' "$output" | sed -n 's/.*complete state graph search is \([0-9]*\).*/\1/p' | tail -1)"

  local violations; violations="$(printf '%s\n' "$output" | parse_violations)"

  # One pass per temporal property. The verdict is `holds` or `violated` and
  # nothing more: TLC's counter-example is a lasso, but its lasso is not
  # canonical the way a breadth-first shortest counter-example is, so two
  # correct checkers can hand back different cycles. A fixture the checker
  # cannot be expected to match is worse than no fixture.
  local verdicts="" prop prop_cfg prop_out
  while IFS= read -r prop; do
    [[ -n "$prop" ]] || continue
    prop_cfg="$WORK/$name-$prop.cfg"
    cfg_one_property "$cfg" "$prop" > "$prop_cfg"
    echo "    property $prop"
    prop_out="$(run_tlc "$dir" "$module" "-config $prop_cfg$deadlock_flag")"

    # The ORDER below is the substance, not a formality (#125).
    #
    # ` distinct states found` is printed by a run that refuted a property just as
    # it is by one that did not -- TLC reports the violation and then finishes its
    # accounting. So a branch reading that line as `holds` is testing for a token
    # the two outcomes SHARE, and it is correct only for as long as every
    # refutation happens to match the pattern above it. That held while every
    # property in the corpus was a temporal one, and stops holding the moment a
    # property has another form: TLC announces
    #
    #     Error: Action property NeverDecreases is violated.
    #
    # for a property written `[][P]_vars`, which the temporal pattern does not
    # match -- and ` distinct states found` sits a few lines below it in the same
    # output. Read in the old order, TLC refuting a property was recorded as
    # `holds`. That is a lie in the one direction nothing can catch: an absent
    # verdict is visible in expected.json, and a wrong one is not.
    #
    # So every refutation is now matched POSITIVELY, and `holds` additionally
    # requires that TLC reported no error at all. Anything else reaches a `die`.
    # An oracle that guesses is worse than one that stops, because D-9 makes these
    # files the definition of "correct" -- there is nothing above them to appeal to.
    if printf '%s\n' "$prop_out" | grep -q '^Error: Action property .* is violated\.'; then
      # Recognised, and deliberately not recorded. Writing `violated` here would put
      # a verdict with no counterexample LENGTH into `properties`, and length is what
      # D-9 compares. The note above explains why a temporal verdict carries none --
      # a lasso is not canonical -- and that reasoning does not reach this shape:
      # `[][P]_vars` is a safety property, so TLC hands back a finite, breadth-first
      # shortest prefix ending at the offending step, exactly like an invariant's.
      # A lengthless verdict would therefore be both wrong and finished-looking.
      # Giving the category its proper shape is #126; until then, stop.
      printf '%s\n' "$prop_out" >&2
      die "$name: $prop is an action property (\`[][P]_vars\`), whose verdict this script cannot record yet -- see #126"
    elif printf '%s\n' "$prop_out" | grep -q '^Error: Temporal properties were violated\.'; then
      verdicts+="$prop violated"$'\n'
    elif printf '%s\n' "$prop_out" | grep -q '^Error:'; then
      printf '%s\n' "$prop_out" >&2
      die "$name: TLC reported an error for $prop that this script does not recognise"
    elif printf '%s\n' "$prop_out" | grep -q ' distinct states found'; then
      verdicts+="$prop holds"$'\n'
    else
      printf '%s\n' "$prop_out" >&2
      die "$name: TLC neither refuted $prop nor finished a search for it"
    fi
  done < <(declared_properties "$cfg")

  local tlc_version
  tlc_version="$(printf '%s\n' "$output" | sed -n 's/^TLC2 Version \([0-9.]*\) .*/\1/p' | head -1)"

  {
    echo '{'
    echo "  \"generated_by\": \"bin/tlc-expected\","
    echo "  \"tla_tools_version\": \"$TLA_TOOLS_VERSION\","
    echo "  \"tlc_version\": \"$tlc_version\","
    echo "  \"module\": \"$module\","

    printf '  "constants": {'
    local first=1 line lhs rhs
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      lhs="${line%%=*}"; rhs="${line#*=}"
      lhs="$(echo "$lhs" | sed 's/[[:space:]]*$//')"
      rhs="$(echo "$rhs" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
      [[ $first -eq 1 ]] || printf ','
      printf '\n    "%s": "%s"' "$(json_escape "$lhs")" "$(json_escape "$rhs")"
      first=0
    done < <(declared_constants "$cfg")
    [[ $first -eq 1 ]] && echo '},' || printf '\n  },\n'

    echo "  \"distinct_states\": $distinct,"
    echo "  \"diameter\": ${diameter:-null},"
    echo "  \"deadlock\": $deadlock,"

    printf '  "invariants": {'
    first=1
    local inv depth
    while IFS= read -r inv; do
      [[ -n "$inv" ]] || continue
      depth="$(printf '%s\n' "$violations" | awk -v i="$inv" '$1 == i { print $2; exit }')"
      [[ $first -eq 1 ]] || printf ','
      if [[ -n "$depth" ]]; then
        printf '\n    "%s": {"violated_at": %s}' "$(json_escape "$inv")" "$depth"
      else
        printf '\n    "%s": "holds"' "$(json_escape "$inv")"
      fi
      first=0
    done < <(declared_invariants "$cfg")
    [[ $first -eq 1 ]] && echo '},' || printf '\n  },\n'

    printf '  "properties": {'
    first=1
    local verdict
    while IFS= read -r prop; do
      [[ -n "$prop" ]] || continue
      verdict="$(printf '%s\n' "$verdicts" | awk -v p="$prop" '$1 == p { print $2; exit }')"
      [[ $first -eq 1 ]] || printf ','
      printf '\n    "%s": "%s"' "$(json_escape "$prop")" "$verdict"
      first=0
    done < <(declared_properties "$cfg")
    [[ $first -eq 1 ]] && echo '}' || printf '\n  }\n'

    echo '}'
  } > "$out"
}

main() {
  local check=0 names=()
  for arg in "$@"; do
    case "$arg" in
      --check) check=1 ;;
      -*) die "unknown option: $arg" ;;
      *) names+=("$arg") ;;
    esac
  done

  if [[ ${#names[@]} -eq 0 ]]; then
    while IFS= read -r d; do names+=("$(basename "$d")"); done \
      < <(find "$CORPUS" -mindepth 1 -maxdepth 1 -type d | sort)
  fi
  [[ ${#names[@]} -gt 0 ]] || die "corpus is empty"

  ensure_jar

  local status=0
  for name in "${names[@]}"; do
    local committed="$CORPUS/$name/expected.json"
    if [[ $check -eq 1 ]]; then
      local tmp; tmp="$(mktemp)"
      generate "$name" "$tmp"
      [[ -f "$committed" ]] || die "$name: no expected.json to check against"
      if ! diff -u "$committed" "$tmp"; then
        echo "!!! $name: TLC no longer reports what expected.json records" >&2
        status=1
      fi
      rm -f "$tmp"
    else
      generate "$name" "$committed"
    fi
  done

  [[ $check -eq 1 && $status -eq 0 ]] && echo "==> corpus agrees with TLC"
  return $status
}

main "$@"
